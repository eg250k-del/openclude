# Keep the build context small. Without this, the whole working directory goes
# to the builder, including .venv, __pycache__ and any local .env holding
# object-storage credentials.
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.git/
.github/
tests/
tools/
work/
out/
clips/
frames/
audio/
outputs/
ckpts/
loras/
cache/
config/
data/
*.log
*.md
!README.md
demo*.py
