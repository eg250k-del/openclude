# SaladCloud: one container, one job at a time

# A `.env` is read by openclude's own tooling. It is git-ignored, so secrets
# stay out of the history. Salad's own guidance is that the API key belongs in
# the environment of the agent's shell, never in a repository — this file is
# for the object-storage credentials only, and even those are optional locally.

# --- SaladCloud ---
# From the Portal, API Access page. Do NOT commit this file.
SALAD_API_KEY=
SALAD_ORGANIZATION=mostafa-ai
SALAD_PROJECT=aoutooanimation

# The image built by .github/workflows/build-image.yml
OPENCLIDE_IMAGE=ghcr.io/eg250k-del/openclude:latest

# --- Object storage (required: Salad disks are ephemeral) ---
# Cloudflare R2. Salad recommend it because it has no egress fees.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- cost control ---
# 500 cents = $5.00 per hour, the hard stop for the project quota.
OPENCLIDE_BUDGET_CENTS=500
# 0 means the group scales to zero when idle, so nothing bills.
OPENCLIDE_MIN_REPLICAS=0
OPENCLIDE_MAX_REPLICAS=3
OPENCLIDE_GPU=RTX 3090 Ti (24 GB)
OPENCLIDE_PRIORITY=low
