# Force LF for anything that ships into a Linux container.
# Without this, git checks out .sh files with CRLF on Windows and bash in the
# image dies with "\r: command not found" on the very first line.
* text=auto eol=lf

*.sh    text eol=lf
Dockerfile text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Binary assets must never be line-ending mangled.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.mp4   binary
*.wav   binary
*.safetensors binary
